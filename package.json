{
  "name": "dsh-codex-reset-tracker",
  "version": "0.5.1",
  "type": "module",
  "description": "DeepSeek Harness plugin showing Codex reset status in the composer and exposing a read-only codex_reset tool.",
  "icon": "./icon.svg",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "assets/screenshot-light.jpg",
    "assets/screenshot-dark.jpg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loshanvren/dsh-codex-reset-tracker.git"
  },
  "scripts": {
    "test": "TZ=Asia/Shanghai node --test",
    "check": "node --check client.js && node --check index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
